{
  // ----------------------------------------------------------------------
  // SWI-Prolog executable (full path)
  // ----------------------------------------------------------------------
  "prolog.executablePath": "C:\\Program Files\\swipl\\bin\\swipl.exe",

  // ----------------------------------------------------------------------
  // VS Code Tasks: which task is the default build task for .pl files
  //   Terminal > Run Build Task  (Ctrl+Shift+B)
  // ----------------------------------------------------------------------
  "terminal.integrated.cwd": "${workspaceFolder}",
  "files.associations": {
    "*.pl": "prolog",
    "*.pro": "prolog",
    "*.prolog": "prolog"
  },

  // ----------------------------------------------------------------------
  // Recommended editor behavior for Prolog files
  // ----------------------------------------------------------------------
  "[prolog]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.quickSuggestions": {
      "comments": false,
      "strings": false,
      "other": true
    },
    "editor.wordWrap": "on"
  },

  // ----------------------------------------------------------------------
  // Tell VS Code to keep the SWI-Prolog build task output visible
  // ----------------------------------------------------------------------
  "task.outputBehavior": "open",

  // ----------------------------------------------------------------------
  // Tell VS Code how to find SWI-Prolog on the PATH for integrated terminal
  // ----------------------------------------------------------------------
  "terminal.integrated.env.windows": {
    "PATH": "C:\\Program Files\\swipl\\bin;${env:PATH}"
  }
}